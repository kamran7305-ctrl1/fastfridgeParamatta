# Hostinger Production .htaccess - Fridge Repair Parramatta

# Enable Rewrite Engine
RewriteEngine On

# 1. Force HTTPS (SSL Security)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 1a. Force the non-www host (every canonical tag, og:url and sitemap.php URL
# uses the non-www form, so www must redirect here rather than serve a
# duplicate copy of the site).
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

# 2. URL Rewriting for URL Slug: /fridge-repair-parramatta/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^fridge-repair-parramatta/?$ index.html [L,QSA]

# 2a. Clean URLs, step 1: redirect any old .html link to its extension-free
# version (301, so old bookmarks/search results/external links still land
# on the right page and pass their SEO value through), so the address bar
# always shows the clean URL rather than just quietly serving both forms.
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^blog\.html$ /blog [R=301,L]
RewriteRule ^blog-([a-z0-9-]+)\.html$ /blog-$1 [R=301,L]
RewriteRule ^(about|contact|emergency-fridge-repair|fridge-repair-cost|services|brands|fridge-not-cooling-repair|fridge-regas|samsung-fridge-repair-parramatta|lg-fridge-repair|commercial-refrigeration-repair|coolroom-repair|commercial-freezer-repair|ice-machine-repair|fridge-door-seal-replacement|freezer-repair|fridge-compressor-repair|areas)\.html$ /$1 [R=301,L]

# 2b. Clean URLs, step 2: serve the real page behind each extension-free
# path. Blog URLs always resolve to the dynamic PHP pages (even though the
# original static blog-*.html files are still sitting on disk, superseded
# by the database-backed admin panel). Pages converted to pull their SEO
# fields from the admin panel (see database/migration_seo_pages.sql) are
# listed individually as they're migrated from .html to .php; everything
# still in the second group below is still a plain static .html file.
RewriteRule ^blog/?$ blog.php [L,QSA]
RewriteRule ^blog-([a-z0-9-]+)/?$ blog-post.php?slug=$1 [L,QSA]
RewriteRule ^about/?$ about.php [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(contact|emergency-fridge-repair|fridge-repair-cost|services|brands|fridge-not-cooling-repair|fridge-regas|samsung-fridge-repair-parramatta|lg-fridge-repair|commercial-refrigeration-repair|coolroom-repair|commercial-freezer-repair|ice-machine-repair|fridge-door-seal-replacement|freezer-repair|fridge-compressor-repair|areas)/?$ $1.html [L,QSA]

# 2c. sitemap.xml is generated on the fly by sitemap.php (scans the site for
# pages and queries published blog posts), so new pages/posts show up
# automatically. This rule always wins over any physical sitemap.xml file.
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# 2d. Block direct web access to backend-only folders and files. These are
# only ever loaded via PHP `require`, never requested directly by a browser.
RewriteRule ^admin/includes/ - [F,L]
RewriteRule ^includes/ - [F,L]
RewriteRule ^database/ - [F,L]
<FilesMatch "\.(sql|sqlite)$">
  Require all denied
</FilesMatch>
<FilesMatch "^config\.php$">
  Require all denied
</FilesMatch>

# Set Default Index Document
DirectoryIndex index.html

# 3. Gzip Compression for Fast Loading Speed
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# 4. Leverage Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
</IfModule>

# 5. Production Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
